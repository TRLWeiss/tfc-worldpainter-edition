+    private static boolean isForeignBlock(IBlockState current)
+    {
+        Block block = current.getBlock();
+        return !(block instanceof BlockRockVariant) && !(block instanceof BlockPeat) && !(block instanceof BlockPeatGrass);
+    }
+
+    /** 原版或其他模组的草方块（草地、菌丝、灰化土以外的同类方块） */
+    public static boolean isVanillaGrass(IBlockState current)
+    {
+        if (!isForeignBlock(current)) return false;
+        Block block = current.getBlock();
+        if (block instanceof net.minecraft.block.BlockGrass || block instanceof net.minecraft.block.BlockMycelium) return true;
+        return current.getMaterial() == Material.GRASS && current.isFullCube() && block != net.minecraft.init.Blocks.HAY_BLOCK && !(block instanceof net.minecraft.block.BlockGrassPath);
+    }
+
+    /** 原版或其他模组的泥土（泥土、砂土、灰化土等） */
+    public static boolean isVanillaDirt(IBlockState current)
+    {
+        if (!isForeignBlock(current)) return false;
+        Block block = current.getBlock();
+        if (block instanceof net.minecraft.block.BlockDirt) return true;
+        return current.getMaterial() == Material.GROUND && current.isFullCube() && !(block instanceof net.minecraft.block.BlockFarmland)
+            && !(block instanceof net.minecraft.block.BlockGrassPath) && !(block instanceof net.minecraft.block.BlockSoulSand);
+    }
+
+    public static boolean isVanillaSoil(IBlockState current)
+    {
+        return isVanillaGrass(current) || isVanillaDirt(current);
+    }
+
+    public static boolean isVanillaSand(IBlockState current)
+    {
+        return isForeignBlock(current) && current.getBlock() instanceof net.minecraft.block.BlockSand;
+    }
+
+    public static boolean isVanillaGravel(IBlockState current)
+    {
+        return isForeignBlock(current) && current.getBlock() instanceof net.minecraft.block.BlockGravel;
+    }
+
+    public static boolean isVanillaStone(IBlockState current)
+    {
+        return current.getBlock() == net.minecraft.init.Blocks.STONE;
+    }
+
+    public static boolean isVanillaGround(IBlockState current)
+    {
+        return isVanillaSoil(current) || isVanillaSand(current) || isVanillaGravel(current) || isVanillaStone(current);
+    }
+
+    /** 放置植物、作物、散石时用：群峦土壤或原版土壤 */
+    public static boolean isSoilForPlacement(IBlockState current)
+    {
+        return isSoil(current) || isVanillaSoil(current);
+    }
+
+    public static boolean isSandForPlacement(IBlockState current)
+    {
+        return isSand(current) || isVanillaSand(current);
+    }
+
+    public static boolean isSoilOrGravelForPlacement(IBlockState current)
+    {
+        return isSoilOrGravel(current) || isVanillaSoil(current) || isVanillaGravel(current);
     }
 
